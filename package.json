{
  "name": "tba3",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard-Suite zur Auswertung von VERA-Daten (Englisch 8, Mathe 3, Schulleitung) - Vanilla-JS-ES-Module, gebaut mit Vite.",
  "homepage": "https://zepf-rptu.github.io/TBA3/",
  "repository": {
    "type": "git",
    "url": "https://github.com/zepf-RPTU/TBA3.git"
  },
  "bugs": {
    "url": "https://github.com/zepf-RPTU/TBA3/issues"
  },
  "license": "MIT",
  "author": "Kai Mannweiler",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath tools/hooks",
    "dev": "vite",
    "build": "vite build && vitepress build docs",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "node tools/run-vitest.mjs run --config config/vitest.config.mjs",
    "test:watch": "node tools/run-vitest.mjs --config config/vitest.config.mjs",
    "test:coverage": "node tools/run-vitest.mjs run --config config/vitest.config.mjs --coverage",
    "test:e2e": "playwright test",
    "test:e2e:export": "playwright test --config tests/e2e-export/playwright.config.js",
    "test:docker": "playwright test --config tests/e2e-docker/playwright.config.js",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "oxlint --deny-warnings src packages config tools tests docs/.vitepress vite.config.js playwright.config.js",
    "lint:css": "eslint --max-warnings 0 --config config/eslint.config.mjs \"src/**/*.css\" \"packages/**/*.css\" \"docs/.vitepress/**/*.css\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check:structure": "node tools/check-structure.mjs",
    "check:deps": "depcruise src packages tests --config config/dependency-cruiser.mjs",
    "check:fixtures": "node tools/gen-sl-history-fixture.mjs --check && node tools/gen-sl-booklet-fixture.mjs --check",
    "check:docs-index": "node tools/docs-sidebar.mjs --check",
    "check:docs-endpoints": "node tools/docs-endpoint-fields.mjs --check",
    "typecheck": "tsc -p config/tsconfig.typecheck.json",
    "check": "run-p --aggregate-output check:structure check:deps check:unused check:unused:prod check:fixtures check:docs-index check:docs-endpoints lint:js lint:css fmt:check typecheck test build",
    "check:unused": "knip --exports --dependencies --files --cycles",
    "check:unused:prod": "knip --production --exports --files"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/css": "^2.0.0",
    "@playwright/test": "1.63.0",
    "@types/d3": "^7.4.3",
    "@types/tabulator-tables": "^6.3.6",
    "@types/trusted-types": "^2.0.7",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.9",
    "knip": "^6.35.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "playwright-core": "$playwright"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@preact/signals-core": "^1.14.4",
    "@tba3/module-base": "*",
    "@tba3/modules": "*",
    "d3": "^7.9.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lit": "^3.3.3",
    "quill": "^2.0.3",
    "quill-delta": "^5.1.0",
    "tabulator-tables": "^6.5.2"
  }
}
