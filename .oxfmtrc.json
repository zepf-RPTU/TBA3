{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "singleQuote": true,
    "ignorePatterns": [
        "dist/",
        "public/",
        "test-results/",
        "coverage/",
        "**/*.json",
        "**/*.md",
        "**/*.css",
        "**/*.html"
    ]
}
