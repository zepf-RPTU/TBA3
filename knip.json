{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": ["dist/**", "public/**", "coverage/**"],
    "workspaces": {
        ".": {
            "entry": [
                "src/common/app/bootstrapDashboardApp.js",
                "src/en/enAppModule.js",
                "src/ma/maAppModule.js",
                "src/sl/slAppModule.js",
                "tools/**/*.mjs",
                "tools/hooks/*",
                "tests/**/*.js",
                "config/*.mjs",
                "config/*.js",
                "docs/.vitepress/**/*.{js,mjs,ts}"
            ],
            "project": ["src/**/*.js"]
        },
        "packages/module-base": {},
        "packages/modules": {}
    },
    "rules": {
        "optionalPeerDependencies": "off"
    }
}
